# Build targets (Cargo)
target/
/target/
/target-*/
target-*/
**/target/

# Build artefacts from the Metal AOT step in build.rs. `default.metallib` is
# the compiled output and `*.air` the intermediate; both are regenerated on
# every build and must not be committed — TESSL_SKIP_AOT exists precisely so a
# known-good one can be dropped in locally without it becoming repo state.
default.metallib
*.metallib
*.air

# Python artifacts & virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
env/
dist/
build/
*.egg-info/

# Native binaries, debug symbols & profiling
*.dSYM/
*.profraw
*.profdata
perf.data
perf.data.old

# Secrets & environment configurations
.env
.env.*
*.pem
*.key
credentials.json

# OS metadata
.DS_Store
**/.DS_Store
Thumbs.db

# Editor & IDE configurations
.idea/
.vscode/
.cursor/
*.swp
*.swo
*~

# Local development, agents & tooling caches
.claude/
.gemini/

# devmap's code-index cache. Regenerated on demand from the source tree, so it
# is derived state, not repo state.
.devmap/

# DevCouncil local ledger cache.
.devcouncil/

# CPU emulator build output (tools/msl_emu/build.sh).
/tools/msl_emu/build/

# GitPulse local state (worktrees, ledger) and the per-checkout Claude account marker.
.gitpulse/
.claude-account

# Rust leftovers: rustfmt backups, crash dumps.
**/*.rs.bk
*.core

# Python test/coverage/notebook caches not covered above.
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/
.hypothesis/
.tox/
.nox/

# Metal/Xcode captures and Instruments traces; large, machine-local.
*.gputrace
*.trace
xcuserdata/
DerivedData/

# Logs and scratch output.
*.log
*.tmp
