# Build targets (Cargo)
target/
/target/
/target-*/
target-*/
**/target/

# Build artefacts from the Metal AOT step in build.rs. `default.metallib` is
# the compiled output and `*.air` the intermediate; both are regenerated on
# every build and must not be committed — TESSL_SKIP_AOT exists precisely so a
# known-good one can be dropped in locally without it becoming repo state.
default.metallib
*.metallib
*.air

# Python artifacts & virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
env/
dist/
build/
*.egg-info/

# Native binaries, debug symbols & profiling
*.dSYM/
*.profraw
*.profdata
perf.data
perf.data.old

# Secrets & environment configurations
.env
.env.*
*.pem
*.key
credentials.json

# OS metadata
.DS_Store
**/.DS_Store
Thumbs.db

# Editor & IDE configurations
.idea/
.vscode/
.cursor/
*.swp
*.swo
*~

# Local development, agents & tooling caches
.claude/
.gemini/

# devmap's code-index cache. Regenerated on demand from the source tree, so it
# is derived state, not repo state.
.devmap/

# DevCouncil local ledger cache.
.devcouncil/

# CPU emulator build output (tools/msl_emu/build.sh).
/tools/msl_emu/build/

# GitPulse local state (worktrees, ledger) and the per-checkout Claude account marker.
.gitpulse/
.claude-account

# Rust leftovers: rustfmt backups, crash dumps.
**/*.rs.bk
*.core

# Python test/coverage/notebook caches not covered above.
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/
.hypothesis/
.tox/
.nox/

# Metal/Xcode captures and Instruments traces; large, machine-local.
*.gputrace
*.trace
xcuserdata/
DerivedData/

# Logs and scratch output, patch rejects, and backups.
*.log
*.tmp
*.orig
*.rej
*.bak
*.backup
/scratch/
scratch/
/tmp/
tmp/

# DevCouncil local state
.devcouncil/*
!/.devcouncil/
!.devcouncil/config.yaml

# Local-only notes: session, branch, build, and wave reports, GitPulse task cards,
# the history-scrub SHA map, and audit notes. Kept on the working machine, not published.
/BRANCH_REPORT*
BRANCH_REPORT*
*BRANCH_REPORT*
*branch_report*
*branch-report*
/BUILD_REPORT*
BUILD_REPORT*
*BUILD_REPORT*
*build_report*
*build-report*
*build_reports*
*build-reports*
*BUILD_REPORTS*
*BUILD-REPORTS*
build_reports/
build-reports/
BUILD_REPORTS/
build_report/
build-report/
BUILD_REPORT/
/WAVE_REPORT*
WAVE_REPORT*
*WAVE_REPORT*
*wave_report*
*wave-report*
*wave_reports*
*wave-reports*
*WAVE_REPORTS*
*WAVE-REPORTS*
wave_reports/
wave-reports/
WAVE_REPORTS/
wave_report/
wave-report/
WAVE_REPORT/
/WAVE_*.md
/wave_*.md
/wave-*.md
/AUDIT_REPORT*
AUDIT_REPORT*
*AUDIT_REPORT*
*audit_report*
*audit-report*
/tasks/
tasks/
.tasks/
**/.tasks/
gp-*.md
**/gp-*.md
gitpulse-tasks/
.gitpulse-tasks/
/docs/history/
/docs/embedgemma2_audit.md

# Claude Code cloud sessions with one repository read this file
# and do not read ~/.claude/settings.json. Machine-local overrides
# stay in .claude/settings.local.json.
!.claude/
.claude/*
!.claude/settings.json
