// ---------------------------------------------------------------- vectors ---

template <typename T>
struct vec2 {
    T x, y;
    vec2() : x(0), y(0) {}
    vec2(T a, T b) : x(a), y(b) {}
    template <typename U>
    explicit vec2(U a) : x(T(a)), y(T(a)) {}
};
template <typename T>
struct vec3 {
    T x, y, z;
    vec3() : x(0), y(0), z(0) {}
    vec3(T a, T b, T c) : x(a), y(b), z(c) {}
};
/// `float4` as tessl's flash-attention kernels use it: elementwise arithmetic
/// and scalar broadcast, 16-byte aligned so a `float *` reinterpreted as
/// `float4 *` (with -fno-strict-aliasing) reads the same four floats.
struct alignas(16) float4 {
    float x, y, z, w;
    float4() = default;
    explicit float4(float s) : x(s), y(s), z(s), w(s) {}
    float4(float a, float b, float c, float d) : x(a), y(b), z(c), w(d) {}
    float4 operator+(const float4 &o) const { return {x + o.x, y + o.y, z + o.z, w + o.w}; }
    float4 operator*(const float4 &o) const { return {x * o.x, y * o.y, z * o.z, w * o.w}; }
    float4 operator*(float s) const { return {x * s, y * s, z * s, w * s}; }
    float4 &operator+=(const float4 &o) { return *this = *this + o; }
};
inline float4 operator*(float s, const float4 &v) { return v * s; }

using uint2 = vec2<uint>;
using uint3 = vec3<uint>;
using ulong2 = vec2<ulong>;
using float2 = vec2<float>;

// ----------------------------------------------------------------- bfloat ---

/// bfloat16 with round-to-nearest-even on conversion, as the GPU's `(bfloat)`
/// cast does.
struct bfloat {
    uint16_t bits = 0;
    bfloat() = default;
    bfloat(float f) {
        uint32_t u;
        std::memcpy(&u, &f, 4);
        if ((u & 0x7fffffffu) > 0x7f800000u) {
            bits = uint16_t((u >> 16) | 0x40u); // quiet NaN
        } else {
            u += 0x7fffu + ((u >> 16) & 1u);
            bits = uint16_t(u >> 16);
        }
    }
    operator float() const {
        uint32_t u = uint32_t(bits) << 16;
        float f;
        std::memcpy(&f, &u, 4);
        return f;
    }
};

// ------------------------------------------------------------------- math ---

namespace emu {
/// MSL_EMU_ULP=N perturbs every fast-math transcendental below by a
/// deterministic -N..N ulps (hashed from its argument), standing in for Metal's
/// approximate `exp`/`log`/`rsqrt`/`pow`/`sin`/`cos`. `precise::` is left exact,
/// as on the device. It is how the on-device tolerances get tested here.
inline int ulp_noise() {
    static const int n = [] {
        const char *e = std::getenv("MSL_EMU_ULP");
        return e ? std::atoi(e) : 0;
    }();
    return n;
}
inline float perturb(float r, float x, int extra = 0) {
    const int n = ulp_noise() == 0 ? 0 : ulp_noise() + extra;
    if (n == 0 || !std::isfinite(r)) return r;
    uint32_t h;
    std::memcpy(&h, &x, 4);
    h ^= h >> 16;
    h *= 0x7feb352du;
    h ^= h >> 15;
    h *= 0x846ca68bu;
    h ^= h >> 16;
    int k = int(h % uint32_t(2 * n + 1)) - n;
    for (; k > 0; --k) r = std::nextafter(r, INFINITY);
    for (; k < 0; ++k) r = std::nextafter(r, -INFINITY);
    return r;
}
} // namespace emu

inline float rsqrt(float x) { return emu::perturb(1.0f / std::sqrt(x), x); }
// Metal documents fast `exp` to 3 + floor(2|x|) ulp: the error grows with the
// argument, so a flat N would understate it exactly where softmax-like and
// decay-like arguments live.
inline float exp(float x) {
    return emu::perturb(std::exp(x), x, int(std::min(std::floor(2.0f * std::fabs(x)), 1000.0f)));
}
inline float log(float x) { return emu::perturb(std::log(x), x); }
inline float pow(float a, float b) { return emu::perturb(std::pow(a, b), a * 31.0f + b); }
inline float sin(float x) { return emu::perturb(std::sin(x), x); }
inline float cos(float x) { return emu::perturb(std::cos(x), x); }
